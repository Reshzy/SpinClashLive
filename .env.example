# Color Rush Live — copy to .env and adjust. Never commit .env.

# production | simulation
COLOR_RUSH_ENV=simulation

# PostgreSQL (Compose default shown). Simulation must use a separate database.
DATABASE_URL=postgresql+psycopg://color_rush:color_rush@127.0.0.1:5432/color_rush_sim
DATABASE_URL_PRODUCTION=postgresql+psycopg://color_rush:color_rush@127.0.0.1:5432/color_rush

# Redis is optional in milestone 1 scoring; required for later projections.
REDIS_URL=redis://127.0.0.1:6379/0

# API bind — loopback by default
COLOR_RUSH_HOST=127.0.0.1
COLOR_RUSH_PORT=8000

# Worker: coordinator | settlement | all
COLOR_RUSH_WORKER_ROLE=all
COLOR_RUSH_WORKER_ID=local-worker-1

# Coordinator lease
COORDINATOR_LEASE_TTL_SECONDS=15
SETTLEMENT_PARTITION_COUNT=8
DRAIN_POLL_INTERVAL_MS=50

# Replace in any non-local deployment
SECRET_KEY=change-me-dev-only

# IANA timezone frozen before first production round
COLOR_RUSH_TIMEZONE=Asia/Manila
