# Color Rush Live — copy to .env and adjust. Never commit .env.

# production | simulation
COLOR_RUSH_ENV=simulation

# PostgreSQL (Compose default shown). Simulation must use a separate database.
# If host 5432 is already in use, switch these URLs to port 5433 (Compose publishes both).
DATABASE_URL=postgresql+psycopg://color_rush:color_rush@127.0.0.1:5432/color_rush_sim
DATABASE_URL_PRODUCTION=postgresql+psycopg://color_rush:color_rush@127.0.0.1:5432/color_rush

# Redis is required for projections, outbox relay, and WebSocket snapshots.
REDIS_URL=redis://127.0.0.1:6379/0
COLOR_RUSH_TEST_REDIS_URL=redis://127.0.0.1:6379/15

# Integration tests (Compose host 5433 if 5432 is already taken)
COLOR_RUSH_TEST_DATABASE_URL=postgresql+psycopg://color_rush:color_rush@127.0.0.1:5432/color_rush_test

# API bind — loopback by default
COLOR_RUSH_HOST=127.0.0.1
COLOR_RUSH_PORT=8000

# Desktop console (never put Google/SQL/Redis secrets here)
COLOR_RUSH_API_BASE=http://127.0.0.1:8000

# Worker: coordinator | ingest | settlement | outbox | projection | gateway | retention | all
COLOR_RUSH_WORKER_ROLE=all
COLOR_RUSH_WORKER_ID=local-worker-1

# Coordinator lease
COORDINATOR_LEASE_TTL_SECONDS=15
SETTLEMENT_PARTITION_COUNT=8
DRAIN_POLL_INTERVAL_MS=50

# Replace in any non-local deployment
SECRET_KEY=change-me-dev-only

# CORS / overlay origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# YouTube (backend-owned; never put real values here — use local .env only)
# Public live chat: GOOGLE_API_KEY is enough. Private/unlisted: also set the OAuth pair.
# Restrict the API key to YouTube Data API v3 in Google Cloud Console.
GOOGLE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/admin/youtube/oauth/callback
YOUTUBE_TRANSPORT=stream

# Owner bootstrap (used once by: uv run python -m color_rush.bootstrap)
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=change-me-owner

# IANA timezone frozen before first production round
COLOR_RUSH_TIMEZONE=Asia/Manila

# /metrics is loopback-only unless this is true
TRUSTED_METRICS=false
